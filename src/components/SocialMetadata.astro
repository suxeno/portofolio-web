---
interface Props { title: string; description: string; image?: {url:string; alt:string; width:number; height:number} | null }
const {title, description, image} = Astro.props;
---
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <><meta property="og:image" content={image.url} /><meta property="og:image:alt" content={image.alt} /><meta property="og:image:width" content={String(image.width)} /><meta property="og:image:height" content={String(image.height)} /></>}
