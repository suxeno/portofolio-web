---
import "../style.css";
import "../section-art.css";
import Terminal from "../components/Terminal.vue";
import ProjectSlider from "../components/ProjectSlider.vue";
import EditorialSection from "../components/EditorialSection.astro";
import ToolsSection from "../components/ToolsSection.astro";
import CertificatesSection from "../components/CertificatesSection.astro";
import { writing, projects, experience, achievements } from "../content";
import { latestWriting } from "../writing-order.mjs";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Arvinanto Bahtiar — data engineer working across data engineering, monitoring, and applied AI." />
  <title>Arvinanto Bahtiar — Data Engineer</title>
  <link rel="icon" href="data:," />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="#top">ARVIN / PROFILE</a>
    <nav aria-label="Main navigation"><a href="#writing">Writings</a><a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#contact">Contact ↗</a></nav>
    <button class="menu-trigger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" hidden><span aria-hidden="true">☰</span></button>
  </header>
  <dialog id="mobile-menu" aria-label="Main navigation">
    <button class="menu-close" type="button" aria-label="Close menu">×</button>
    <nav aria-label="Mobile navigation"><ul><li><a href="#writing">Writings</a></li><li><a href="#projects">Projects</a></li><li><a href="#experience">Experience</a></li><li><a href="#contact">Contact ↗</a></li></ul></nav>
  </dialog>
  <main id="main">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="terminal">
        <h1 id="hero-title"><button class="motion-toggle art-toggle" type="button" aria-label="Pause animations" aria-pressed="false">Arvin</button></h1>
        <p class="role">Data Engineering | ML/AI Engineering</p>
        <p class="intro">Building reliable data pipelines and scalable data solutions for analytics and AI-powered applications.</p>

        <nav class="terminal-list" aria-label="Portfolio directories"><a href="#writing">Writings ↗</a><a href="#projects">Projects ↗</a><a href="#experience">Experience ↗</a><a href="#achievements">Achievements ↗</a><a href="#contact">Contact ↗</a></nav>
        <Terminal client:load />
        <noscript><p>Command input requires JavaScript. Directory links remain available.</p></noscript>
      </div>
    </section>

    <EditorialSection id="writing" lead="" emphasis="Writings">
      {latestWriting(writing).map((item, index) => <div class="entry"><a class="writing-link" href={`/writing/${item.slug}/`}><span>{item.publishedAt ?? 'SAMPLE DRAFT'}</span><strong>{item.title}</strong><span>Read article ↗</span></a></div>)}
      <p class="writing-more"><a href="/writing/">See all writings ↗</a></p>

    </EditorialSection>
    <EditorialSection id="projects" lead="" emphasis="Projects">
      <ProjectSlider client:load items={projects.map(item => item)} />
    </EditorialSection>
    <ToolsSection />
    <EditorialSection id="experience" lead="" emphasis="Experience">
      {experience.map(item => <div class="entry"><div class="entry-date">{item.date}</div><h3>{item.title}</h3><p>{item.organization}</p></div>)}
    </EditorialSection>
    <EditorialSection id="achievements" lead="" emphasis="Achievements">
      {achievements.map(item => <div class="entry"><p>{item}</p></div>)}
    </EditorialSection>
    <CertificatesSection />
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap contact-inner"><div class="contact-art"><canvas class="section-art" data-dither="contact" aria-hidden="true" width="96" height="72"></canvas></div><div><h2 id="contact-title" class="contact-invitation" tabindex="-1">Building something with Data or AI?</h2><div class="contact-links"><a href="mailto:arvinantobahtiar@gmail.com">Contact me ↗</a><a href="https://www.linkedin.com/in/arvinanto/">LinkedIn <span aria-hidden="true">↗</span></a><a href="https://github.com/suxeno">GitHub <span aria-hidden="true">↗</span></a><a href="https://medium.com/@arvinantobahtiar">Medium <span aria-hidden="true">↗</span></a></div></div></div>
    </section>
  </main>
  <footer class="wrap"><span>ARVIN / PROFILE</span><nav aria-label="Footer navigation"><a href="#writing">Writings</a><a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#achievements">Achievements</a><a href="#contact">Contact</a></nav><a href="#top">Back to top ↑</a></footer>
<script>import "../main"; import "../section-art"; import "../mobile-nav";</script>
</body>
</html>
