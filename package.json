{
  "name": "portofolio-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "astro check && vue-tsc --noEmit",
    "test": "bun run build && node --test tests/*.test.mjs",
    "build": "astro build",
    "check:deploy": "wrangler deploy --config wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "@astrojs/vue": "7.1.2",
    "astro": "7.4.7",
    "gsap": "3.15.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "wrangler": "4.158.0"
  }
}
